{
    "firsttext": [
        "\uc5b4\ub460\uc774 \uae54\ub9b0, \uc544\ubb34 \uc18c\ub9ac \uc5c6\ub294 \uace0\uc694\ud55c \uc232.",
        "\ub2f9\uc2e0\uc740 \uc794\uc794\ud55c \ud480\ubc8c\ub808 \uc18c\ub9ac\uc5d0 \uc7a0\uc5d0\uc11c \uae68\uc5b4\ub0a9\ub2c8\ub2e4.",
        "\ucc28\uac00\uc6b4 \ud55c\uae30\uc640 \uc2b5\uae30 \uc11c\ub9b0 \ud480\ub0b4\uc74c\uc774 \ub2f9\uc2e0\uc744 \ucc28\ubd84\ud558\uac8c \ud574\uc8fc\uc9c0\ub9cc,",
        "\uc9d9\uc740 \uc5b4\ub460\uacfc \uace0\ub3c5\ud55c \uc801\ub9c9\uc740 \uc5b4\ub518\uc9c0 \ubaa8\ub974\uac8c \ub450\ub824\uc6c0\uc744 \uc790\uc544\ub0c5\ub2c8\ub2e4.",
        "\ud558\uc9c0\ub9cc \uac71\uc815\ud558\uc9c0 \ub9c8\uc138\uc694."
    ],
    "beforetext": "\ub2f9\uc2e0 \uacc1\uc5d0\ub294",
    "options": {
        "sword": [
            "\uc6a9\uc0ac \ud29c\ud1a0\ub9ac\uc5bc\uc758 \uac80",
            "\uc6a9\uc0ac \ud29c\ud1a0\ub9ac\uc5bc\uc758 \uac80\uc774 \uc788\uc73c\ub2c8\uae4c\uc694."
        ],
        "gun": [
            "\ub450 \uc790\ub8e8\uc758 \uad8c\ucd1d",
            "\ub450 \uc790\ub8e8\uc758 \uad8c\ucd1d\uc774 \uc788\uc73c\ub2c8\uae4c\uc694"
        ]
    },
    "middletext": [],
    "endtext": "\uc774\uc81c \uc790\ub9ac\uc5d0\uc11c \uc77c\uc5b4\ub098, \ubaa8\ud5d8\uc744 \uc2dc\uc791\ud569\uc2dc\ub2e4."
}